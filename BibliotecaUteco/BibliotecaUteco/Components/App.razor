    <link rel="stylesheet" href="dist.css"/>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BibliotecaUteco.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="_content/Blazor.Sonner/styles.css" rel="stylesheet" />

    <HeadOutlet @rendermode="@(new InteractiveWebAssemblyRenderMode(false))" />
</head>

<body>
<Routes @rendermode="@(new InteractiveWebAssemblyRenderMode(false))" />
<script src="_content/LumexUI/js/LumexUI.js" type="module"></script>
<script src="_content/BlazorAnimate/blazorAnimateInterop.js"></script>
<script src="_framework/blazor.web.js"></script>


<script>
    
    window.triggerClick = (element) => {
     if (element) element.click();
    };

    window.dropdownManager = {
        open(selector) { /* ... */ },
        closeAll() {
            document.querySelectorAll('[data-popover]').forEach(p => p.remove());
        }
    };

    window.removeDropdownOverlay = function (id) {
        try {
            // Overlay
            const overlay = document.querySelector(`[data-popover-overlay="${id}"]`);
            if (overlay && overlay.parentNode) {
                overlay.parentNode.removeChild(overlay);
            }

            // Popover principal
            const popover = document.querySelector(`[data-popover="${id}"]`);
            if (popover && popover.parentNode) {
                popover.parentNode.removeChild(popover);
            }
        } catch (err) {
            console.warn("Error removing dropdown overlay:", err);
        }
    };

    window.copyToClipboard = (text) => {
        navigator.clipboard.writeText(text)
            .catch(err => console.error("Error al copiar al portapapeles:", err));
    };

    window.popoverZIndexManager = {
    observer: null,
    baseZIndex: 9999,
    
    initialize: function() {
        this.adjustZIndexes();
        
        // Observer para detectar nuevos popovers
        this.observer = new MutationObserver(() => {
            this.adjustZIndexes();
        });
        
        this.observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['data-popover', 'data-popover-overlay']
        });
    },
    
    adjustZIndexes: function() {
        // Obtener todos los pares overlay-popover
        const overlays = document.querySelectorAll('[data-popover-overlay]');
        
        overlays.forEach((overlay, index) => {
            const popoverId = overlay.getAttribute('data-popover-overlay');
            const popover = document.querySelector(`[data-popover="${popoverId}"]`);
            
            if (popover && overlay) {
                const overlayZIndex = this.baseZIndex + (index * 2);
                const popoverZIndex = overlayZIndex + 1;
                
                overlay.style.zIndex = overlayZIndex.toString();
                popover.style.zIndex = popoverZIndex.toString();
            }
        });
    },
    
    dispose: function() {
        if (this.observer) {
            this.observer.disconnect();
            this.observer = null;
        }
    }
};

    window.printElement = (docName, divId) => {
        
        try{
            const divContent = document.getElementById(divId).innerHTML;
            const printWindow = window.open('', '', 'height=600,width=800');

            // Escribe el HTML inicial con el <head> incluyendo la fuente
            printWindow.document.write(`
        <html>
        <head>
            <title>${docName}</title>
            <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Inconsolata:wght@200..900&display=swap" rel="stylesheet">
            <style>
                body {
                    font-family: 'Geist', 'Inconsolata', sans-serif;

                }
            </style>
        </head>
        <body class="bg-black">
            ${divContent}
        </body>
        </html>
    `);

            printWindow.document.close();

            printWindow.onload = () => {
                printWindow.document.title = docName;
                printWindow.focus();
                printWindow.print();
            };
        }
        catch(error)
        {
            console.log(error);
        }
        
    };


</script>
</body>

</html>

