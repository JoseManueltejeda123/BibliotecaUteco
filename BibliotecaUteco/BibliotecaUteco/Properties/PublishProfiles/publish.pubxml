<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <PublishProfile>bibliouteco-001-site1 - Web Deploy</PublishProfile>
        <WebPublishMethod>MSDeploy</WebPublishMethod>
        <PublishProvider>MSDeploy</PublishProvider>

        <MSDeployServiceURL>https://win1017.site4now.net:8172/msdeploy.axd?site=bibliouteco-001-site1</MSDeployServiceURL>
        <DeployIisAppPath>bibliouteco-001-site1</DeployIisAppPath>

        <UserName>bibliouteco-001</UserName>
        <Password>bibliouteco-123</Password> <!-- vacío, igual que el XML original -->

        <DestinationAppUrl>http://bibliouteco-001-site1.anytempurl.com/</DestinationAppUrl>

   
        <!-- Defaults -->
        <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
        <LastUsedPlatform>Any CPU</LastUsedPlatform>
        <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
        <_SavePWD>false</_SavePWD>
    </PropertyGroup>
    <PropertyGroup>
        <ExcludeFilesFromDeployment>wwwroot/BookCovers/**</ExcludeFilesFromDeployment>
        <ExcludeFilesFromDeployment>wwwroot/UserPictures/**</ExcludeFilesFromDeployment>
    </PropertyGroup>
</Project>
