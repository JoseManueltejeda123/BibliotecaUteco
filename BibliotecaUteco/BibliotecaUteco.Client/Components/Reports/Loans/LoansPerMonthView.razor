<div class="flex flex-col gap-3 w-full">
    
    <div class="flex items-center justify-between gap-3 mb-2">
        <div class="flex flex-col">
            <h3 class="text-[28px] font-semibold">Reportes</h3>
            <label class="text-[13px] font-semibold opacity-80">Prestamos por mes</label>

        </div>
        
        <a @onclick="async () => { await OnClose.InvokeAsync(); }" class="text-[13px] cursor-pointer font-semibold text-green-700 underline">Cerrar</a>
    </div>
    
    <div class="flex w-full items-center gap-3">
       
        <LumexNumbox TValue="int?"
                     min="1"
                     max="@DateTime.Now.Year"
                     Placeholder="Itroduce el año para el reporte"
                     LabelPlacement="@LabelPlacement.Inside"
                     ValueChanged="HandleYearChanged"
                     Value="@RequestModel.Year"
                     Label="Año del reporte"
                     Behavior="InputBehavior.OnInput"
                     Disabled="_fetching"
                     />
       
        <LumexButton OnClick="FetchGetLoansPerMonthAsync" Disabled="@_fetching" Class="mt-auto" Color="ThemeColor.Primary">
            Buscar
        </LumexButton>



    </div>
        @if(LoansPerMonth.MonthLoanCount.Any())
        {
             <SectionDivider Name=@($"Prestamos por mes del {RequestModel.Year}")/>
        }
        else if(!LoansPerMonth.MonthLoanCount.Any() && !_fetching)
        {
            <div class="w-full flex items-center justify-center">
                <p class="text-[13px] font-semibold opacity-80">No hay prestamos en este año</p>
            </div>

        }
    <div class="flex flex-col-reverse gap-3 w-full">
        
       
      

        @{
            int prevValue = 0;

            foreach(var loan in LoansPerMonth.MonthLoanCount)
            {
                <div class="flex w-full items-center gap-3 justify-between">
                   
                    <div class="flex flex-col ">
                        <p class="font-semibold line-clamp-1 text-[15px] text-black">@loan.Value Prestamos</p>
                        <p class="font-medium line-clamp-1 opacity-80 text-xs">

                            @loan.Key
                        </p>
                    </div>
                     @if( loan.Value == prevValue || loan.Value == 0)
                    {
                        
                        <div class="rounded-full bg-neutral-300/50  border-neutral-400 border shrink-0 text-neutral-300 w-[25px] h-[25px] flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class=" text-neutral-600 lucide lucide-equal-icon lucide-equal"><line x1="5" x2="19" y1="9" y2="9"/><line x1="5" x2="19" y1="15" y2="15"/></svg>                       
                         </div>
                        
                    }
                    else if(prevValue > loan.Value)
                    {
                        <div class="rounded-full bg-red-300/50 border-red-400 border shrink-0 w-[25px] h-[25px] aspect-square flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-600 lucide lucide-arrow-down-icon lucide-arrow-down"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>                       
                         </div>
                    }
                    else if(prevValue < loan.Value)
                    {
                         <div class="rounded-full  bg-green-300/50 border-green-400 border shrink-0 text-green-600 aspect-square w-[25px] h-[25px] flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600 lucide lucide-arrow-up-icon lucide-arrow-up"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>                      
                              </div>
                    }
                    
                </div>

                prevValue = loan.Value;
            }
        }
        
       
        
        @if(_fetching)
        {
            <div class="w-full flex items-center justify-center"><LumexSpinner Size="Size.Small" Variant="SpinnerVariant.Classic"/></div>
            

        }

    </div>


</div>

@code {


  public bool _fetching { get; set; } = false;
    public int Year {get; set;} = DateTime.Now.Year;
    public LoansPerMonthResponse LoansPerMonth { get; set; } = new();
    public GetLoansPerMonthRequest RequestModel {get; set;} = new();
    
    [Parameter]
    public EventCallback OnClose {get; set;}
    
   
    
    
   
    
}

@functions{
    public void HandleYearChanged(int? value)
    {
        RequestModel.Year = value ?? DateTime.Now.Year;
    }
    protected override async Task OnInitializedAsync()
    {
         await FetchGetLoansPerMonthAsync();
    }

    public async Task FetchGetLoansPerMonthAsync()
    {
        _fetching = true;
        StateHasChanged();
        var result = await ReportsApiServices.GetLoansPerMonthAsync(RequestModel);

        if (result.IsSuccessful()){
           LoansPerMonth = result.Data;
        }
        _fetching = false;
        StateHasChanged();
    }
}