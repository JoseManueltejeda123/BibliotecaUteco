<div id="topLibrosPorFechaInvoice"
     style="width: 100%; gap: 8px; padding: 20px; display: flex; flex-direction: column; justify-content: center;">
    <div style="width: 100%; display: flex; gap: 4px; align-items: center; justify-content: space-between">
        <p style="font-family: 'Inconsolata'; font-size: 16px; font-weight: 600;">TOP LIBROS @Model.Year / @Model.Month </p>
        <img src="https://uteco.edu.do/wp-content/uploads/2021/04/Logo-Pag.jpg"
             style="width: 150px; object-fit: contain; height: 50px;"/>
    </div>


   

    <div style="width: 100%; display: flex; align-items: center; gap: 2px; opacity: 0.7; margin: 10px 0px;">
        <span style="font-size: 14px; text-wrap: nowrap; font-weight: 600; font-family: 'Inconsolata'">TOP LIBROS POR MES DEL AÑO @Model.Year</span>
        <hr style="border-bottom: 1px solid black; width: 100%;"/>
    </div>

    <div style="width: 100%; display: flex;  gap: 8px; flex-direction: column;">

        @foreach (var book in Model.Books)
        {
            <div style="display: flex; flex-direction: column;">
                <span
                    style="padding: 0 2px; font-family: 'Inconsolata'; font-size: 14px; text-wrap: nowrap; font-weight: 600; color: black;">@(Model.Books.IndexOf(book) + 1) @book.Name.ToUpper()</span>
                <span style="font-family: 'Inconsolata'; font-size: 14px; color: dimgray; ">
                    
                    @if (book.Authors.Any())
                    {
                        @(book.Authors.FirstOrDefault()?.Author.FullName.ToUpper() ?? "SIN AUTOR")
                    }
                </span>
                <span style="font-family: 'Inconsolata'; opacity: 0.5; font-size: 14px; ">
                    
                   @if (book.Authors.Count >= 2)
                    {
                        @(book.Authors.Count() - 1)
                        @(" MÁS")
                    }
                </span>

            </div>
        }


    </div>

    <div style="width: 100%; display: flex; align-items: center; gap: 2px; opacity: 0.7; margin: 10px 0px;">
        <span style="font-size: 14px; text-wrap: nowrap; font-weight: 600; font-family: 'Inconsolata'">RESUMEN</span>
        <hr style="border-bottom: 1px solid black; width: 100%; "/>

    </div>
    <div>
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray; ">CANTIDAD DE PRESTAMOS DEL @Model.Year:
            <span style="color: black; padding: 0 2px;">@Model.Books.Count() LIBROS</span></p>
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600;color: dimgray;  ">FECHA DE LA CONSULTA:
            <span style="color: black; padding: 0 2px;">
                @DateTime.Now.ToString("dd MMMM yyyy hh:mm:ss")
            </span>
        </p>
       
    </div>

    <div
        style="width: 100%; gap: 0 !important; display: flex; flex-direction: column; justify-content: center; opacity: 0.7; margin-top: 200px; align-items: center;">
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; ">BIBLIOTECA UTECO</p>
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 500; ">COTUÍ, SÁNCHEZ RAMÍREZ, REP. DOM.
            (43000) </p>
    </div>
</div>


@code {

    [Parameter] public EventCallback OnPrinted { get; set; }

    [Parameter] public TopBooksResponse Model { get; set; } = new();
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("printElement", $"TopLibrosPorFecha{Model.Year}", "topLibrosPorFechaInvoice");
            await OnPrinted.InvokeAsync();
        }
    }

}