<div id="loaninvoice"
     style="width: 100%; gap: 8px; padding: 20px; display: flex; flex-direction: column; justify-content: center;">
    <div style="width: 100%; display: flex; gap: 4px; align-items: center; justify-content: space-between">
        <p style="font-family: 'Inconsolata'; font-size: 16px; font-weight: 600;">TICKET DE PRÉSTAMO</p>
        <img src="https://uteco.edu.do/wp-content/uploads/2021/04/Logo-Pag.jpg"
             style="width: 150px; object-fit: contain; height: 50px;"/>
    </div>


    <div style="width: 100%; display: flex; gap: 16px; justify-content: space-between; margin-top: 50px;">
        <div>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray; ">PRÉSTAMO PARA:
                <span style=" padding: 0 2px; color: black;">@Loan.Reader.FullName.ToUpper()</span></p>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray; ">ID LECTOR: <span
                    style=" padding: 0 2px;color: black;">@Loan.ReaderId</span></p>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray; ">CÉDULA DEL
                LECTOR: <span style="padding: 0 2px;color: black;">
                
                @if (!string.IsNullOrEmpty(Loan.Reader.IdentityCardNumber))
                    {
                        @Loan.Reader.IdentityCardNumber
                    }
                    else
                    {
                        @("------")
                    }
            </span></p>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray;">MATRÍCULA: <span
                    style=" padding: 0 2px; color: black;">
                @if (!string.IsNullOrEmpty(Loan.Reader.StudentLicence))
                    {
                        @Loan.Reader.StudentLicence
                    }
                    else
                    {
                        @("------")
                    }
            </span></p>
        </div>

        <div>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray;  ">ID DEL PRÉSTAMO:
                <span style=" padding: 0 2px; color: black;">@Loan.Id</span></p>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray;  ">FECHA DE
                CREACIÓN: <span style=" padding: 0 2px; color: black;">@Loan.CreatedAtLocalFormatted</span></p>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray;  ">FECHA DE
                VENCIMIENTO: <span style=" padding: 0 2px; color: black;">@Loan.DueDateLocalFormatted</span></p>
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray; ">LAPSO DE TIEMPO:
                <span style=" padding: 0 2px; color: black;">@Loan.MaxLoanDays DÍAS</span></p>
        </div>
    </div>

    <div style="width: 100%; display: flex; align-items: center; gap: 2px; opacity: 0.7; margin: 10px 0px;">
        <span style="font-size: 14px; text-wrap: nowrap; font-weight: 600; font-family: 'Inconsolata'">LIBROS</span>
        <hr style="border-bottom: 1px solid black; width: 100%;"/>

    </div>

    <div style="width: 100%; display: flex; align-items: center; gap: 2px;">

        @foreach (var book in Loan.Books)
        {
            <div style="display: flex; flex-direction: column;">
                <span
                    style="padding: 0 2px; font-family: 'Inconsolata'; font-size: 14px; text-wrap: nowrap; font-weight: 600; color: black;">@(Loan.Books.IndexOf(book) + 1) @book.Name.ToUpper()</span>
                <span style="font-family: 'Inconsolata'; font-size: 14px; color: dimgray; ">
                    
                @if (book.Authors.Any())
                    {
                        @(book.Authors.FirstOrDefault()?.Author.FullName.ToUpper() ?? "SIN AUTOR")
                    }
                </span>
                <span style="font-family: 'Inconsolata'; opacity: 0.5; font-size: 14px; ">
                    
                   @if (book.Authors.Count >= 2)
                    {
                        @(book.Authors.Count() - 1)
                        @(" MÁS")
                    }
                </span>

            </div>
        }


    </div>

    <div style="width: 100%; display: flex; align-items: center; gap: 2px; opacity: 0.7; margin: 10px 0px;">
        <span style="font-size: 14px; text-wrap: nowrap; font-weight: 600; font-family: 'Inconsolata'">RESUMEN</span>
        <hr style="border-bottom: 1px solid black; width: 100%; "/>

    </div>
    <div>
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray; ">CANTIDAD DE LIBROS:
            <span style="color: black; padding: 0 2px;">@Loan.Books.Count() LIBROS</span></p>
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600;color: dimgray;  ">ESTADO DEL PRESTAMO:
            <span style="color: black; padding: 0 2px;">
            @if (Loan.ReturnedDate is not null)
                {
                    @("DEVUELTO")
                }
                else
                {
                    if (Loan.IsExceeded)
                    {
                        @("EXCEDIDO")
                    }
                    else
                    {
                        @("PENDIENTE")
                    }
                }
        </span></p>
        @if (Loan.ReturnedDate is not null)
        {
            <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; color: dimgray; ">FECHA DE RETORNO:
                <span style="color: black; padding: 0 2px;">@Loan.ReturnedDateLocalFormatted</span></p>

            if (Loan.HasPenalty)
            {
                <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600;color: dimgray;  ">TIENE
                    PENALIZACIÓN: <span style="color: black; padding: 0 2px;">SI</span></p>
            }
        }
    </div>

    <div
        style="width: 100%; gap: 0 !important; display: flex; flex-direction: column; justify-content: center; opacity: 0.7; margin-top: 200px; align-items: center;">
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 600; ">GUARDA ESTE COMPROBANTE PARA PODER
            HACER RECLAMOS</p>
        <p style="font-family: 'Inconsolata'; font-size: 14px; font-weight: 500; ">COTUÍ, SÁNCHEZ RAMÍREZ, REP. DOM.
            (43000) </p>
    </div>
</div>


@code {

    [Parameter] public EventCallback OnPrinted { get; set; }

    [Parameter] public LoanResponse Loan { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("printElement", $"prestamo_{Loan.Id.ToString()}", "loaninvoice");
            await OnPrinted.InvokeAsync();
        }
    }

}