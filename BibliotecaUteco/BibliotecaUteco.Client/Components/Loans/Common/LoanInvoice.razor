@code {

    [Parameter]
    public EventCallback OnPrinted {get; set;}
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
                await JsRuntime.InvokeVoidAsync("printElement", "loaninvoice");
                await OnPrinted.InvokeAsync();

        }

    }
}