<div class="border text-neutral-900 flex-wrap border-neutral-200 bg-neutral-50 hover:bg-neutral-100 w-full rounded-lg flex justify-between p-3 items-start gap-3">
            <div class="  rounded-lg gap-2 flex flex-col w-full">
                <div class="flex w-full items-center justify-between">
                    <label class="text-[16px] text-black font-semibold">Préstamo para @Loan.Reader.FullName</label>
                    <LumexTooltip ShowArrow="true" Content=@("Copiar Id") Size="Size.Small">
                        <CopyIcon Size="18px"/>
                    </LumexTooltip>
                </div>

                <div class="flex w-full items-center gap-2">
                    <label class="text-xs font-normal">Id: @Loan.Id</label>

                    <div class="border rounded-full border-neutral-300 h-[10px] "/>
                    <label class="text-xs font-normal">Matrícula: 
                        @if (!string.IsNullOrEmpty(Loan.Reader.StudentLicence))
                          {
                                @Loan.Reader.StudentLicence
                          }
                        else
                        {
                            @("-------")
                        }
                        
                        
                    </label>
                    <div class="border rounded-full border-neutral-300 h-[10px] "/>
                    <label class="text-xs font-normal">Cédula: @Loan.Reader.IdentityCardNumber</label>


                </div>
               

                <span class="font-semibold text-sm mt-2 inconsolata">Desde <span class="bg-neutral-950 text-white ">@Loan.CreatedAtLocalFormatted</span> al <span class="bg-black text-white inconsolata">@Loan.DueDateLocalFormatted</span> </span>
                @if(@Loan.ReturnedDate is not null){
                    <span class="font-semibold text-sm mt-2 inconsolata">Entregado el <span class="bg-black text-white ">@Loan.ReturnedDateLocalFormatted</span> </span>

                }

               <SidebarSectionDivider Name="Detalles"/>

                <div class="w-full flex items-center gap-2">
            
                    @if(@Loan.ReturnedDate is not null)
                    {
                        <LumexChip Size="Size.Small" Variant="ChipVariant.Flat" Color="ThemeColor.Primary" StartContent="@_checkIcon">Entregado</LumexChip>
                        
                    }
                    else
                    {
                        @if(Loan.IsExceeded)
                        {
                            <LumexChip Size="Size.Small" Variant="ChipVariant.Flat" Color="ThemeColor.Danger" StartContent="@_warningIcon">Execedido por @(Loan.ExceededBy) dias</LumexChip>

                        }
                        else
                        {
                            <LumexChip Size="Size.Small" Variant="ChipVariant.Flat" Color="ThemeColor.Info" StartContent="@_clockIcon">Pendiente</LumexChip>

                        }
                        <LumexButton OnClick="SetMarkLoanConfirmationModal" Disabled="@_markingLoanAsReturned" Class="ml-auto" Size="Size.Small" Color="ThemeColor.Primary" Variant="Variant.Ghost">Marcar como entregado</LumexButton>
                    }
                </div>
                
                <SidebarSectionDivider Name="Libros"/>
            
                @foreach (var book in Loan.Books.Take(ShowAllBooks ? Loan.Books.Count() : 1))
                {
                    <BookCardMini ShowAvailability="false" Book="@book" @key="book.Id"/>
                }
                @if(Loan.Books.Count() > 1)
                {
                    <a class="text-green-700 text-[13px] underline cursor-pointer" @onclick="() => { ShowAllBooks = !ShowAllBooks;}">@(ShowAllBooks ? "Ocultar libros" : $"Mostrar +{Loan.Books.Count() - 1 } libros ")</a>

                }

            </div>
            

          
</div>


@code{
    public RenderFragment _checkIcon {get; set;} = @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-check-icon lucide-check-check"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg>;
    public RenderFragment _clockIcon {get; set;} = @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock-icon lucide-clock"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>;
    public RenderFragment _warningIcon {get; set;} = @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert-icon lucide-triangle-alert"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>;
    public RenderFragment _penalty {get; set;}
    
    [Parameter]
    public LoanResponse Loan { get; set; } = new();

    public bool ShowAllBooks { get; set; } = false;
    
    public bool _markingLoanAsReturned {get; set;}
}

@functions{

   protected override void OnInitialized()
   {
       _penalty = @<p class="text-sm text-red-600">@(Loan.IsExceeded ? $"Este préstamo está vencido por {Loan.ExceededBy} días. Se creará una penalización automática por un monto de RD$ {Loan.ExceededBy * LoanSettings.DailyFineRate:N2}" : "")</p>;
   }
    public async Task SetMarkLoanConfirmationModal()
    {
        if(_markingLoanAsReturned) return;


        var confirmed = await DialogService.ShowAsync(
            title: "Marcar prestamo como entregado",
            body: $"Si marcas este préstamo como entregado no se podrá desmarcar.",
            acceptText: "Sí, Proceder",
         
            acceptColor: Loan.IsExceeded ?  ThemeColor.Danger : ThemeColor.Primary,
            childContent: _penalty,
            cancelText: "Cancelar"
            
            
            
        );

        if (confirmed)
        {
            await FetchMarkLoanAsReturnedAsync();
        }
    }

    public async Task FetchMarkLoanAsReturnedAsync()
    {
        _markingLoanAsReturned = true;
        StateHasChanged();

        var result = await LoansApiServices.MarkAsReturnedAsync(new() { LoanId = Loan.Id });

        if (result.IsSuccessful())
        {
            if (Loan.IsExceeded)
            {
                Toast.Warning("Préstamo devuelto con exito. Se ha creado una penalización para este préstamo.");
            }
            else
            {
                Toast.Success("Préstamo marcado como devuelto");
            }
            
            Loan.ReturnedDate = result.Data.ReturnedDate;
        }
        
        
        _markingLoanAsReturned = false;
        StateHasChanged();
        
        
    }

}