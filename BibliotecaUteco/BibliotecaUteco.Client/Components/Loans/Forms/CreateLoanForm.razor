@using System.Globalization
@if(ShowInvoice)
{
    <div class="hidden">
        <LoanInvoice Loan="_loanToInvoice" OnPrinted=" () => {  ShowInvoice = false;  }"/>
    </div>
}
<EditForm Model="CreateLoanModel"  class="flex w-full absolute flex-col justify-center">
    <DataAnnotationsValidator/>
    <div class="w-full flex flex-col gap-3 p-3 mt-[50px] ">
        
        <p class="text-[13px] opacity-80">Estas a punto de crear un préstamo para @(Reader.FullName). los prestamos tienen un tiempo máximo de @LoanSettings.MaxLoanDays dias. Despues de pasado 24 horas de la fecha de entrega este se marca como excedido. </p>
        
        <div class="flex flex-col gap-1 w-full">
            <ReaderCardMini Reader="@Reader"/>
        </div>
        
        <SectionDivider Name="Libros a prestar"/>

        <LumexPopover Shadow="Shadow.Medium" ShowArrow="true">
            <LumexPopoverTrigger>
                <LumexButton Disabled="@(SelectedBooks.Count() >= 10 || _creatingLoan)" Size="Size.Small" Variant="Variant.Flat" Color="ThemeColor.Default">Aregar libro</LumexButton>
            </LumexPopoverTrigger>
            <LumexPopoverContent Class="w-full px-2 py-3 flex flex-col gap-1 w-[250px] h-fit " >
                <LumexTextbox Type="@InputType.Search"
                              Label="Buscar libro"
                              Value="@BookFilter"
                              Placeholder="Ej. Cancion de Hielo y Fuego"
                              LabelPlacement="@LabelPlacement.Outside"
                              Disabled="@_searchingBooks"
                              Clearable="@true"
                              Size="Size.Small"
                              ValueChanged="HandleSearchBookTextChanged"
                              Behavior="InputBehavior.OnInput"
                              OnCleared="async()=>{await FetchGetBooksByName();}"
                />
                @if(_searchingBooks)
                {
                    <LumexSpinner Variant="SpinnerVariant.Classic" Size="Size.Small"/>
                }
                @if(!SearchedBooks.Any())
                {
                    <p class="text-xs">Sin resultados \(o_o)/</p>
                }
                @foreach(var book in SearchedBooks)
                {
                    <BookCardMini OnAddClicked="HandleBookAdded" ShowAddButton="@(!SelectedBooks.Any(b => b.Id == book.Id))" Book="@book"/>
                }
            </LumexPopoverContent>
        </LumexPopover>
        @foreach(var book in SelectedBooks)
        {
            <BookCardMini ShowRemoveButton="@(!_creatingLoan)" OnRemoveClicked="HandleBookRemoved" ShowAddButton="@(false)" Book="@book"/>
        }
        
        <p class="text-[13px] opacity-80">Máximo 10 libros. @SelectedBooks.Count() @("/10") seleccionados </p>
        <SectionDivider Name="Duración del prestamo"/>
        
        @if (SelectedBooks.Any())
        {
            <Animate class="flex flex-col gap-3" Animation="@Animations.FadeIn" Duration="TimeSpan.FromMilliseconds(300)">

                <LumexNumbox TValue="int"
                             Label="Dias del prestamo"
                             Placeholder="1"
                             step="1"
                             max="30"
                             min="1"
                             Disabled="@(_creatingLoan)"
                             @bind-Value="CreateLoanModel.MaxLoanDays"
                             Size="Size.Small"
                             LabelPlacement="@LabelPlacement.Inside"
                             EndContent="@_clockDangerIcon" />
                <div class="flex w-full gap-3 items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-700 lucide lucide-clock-icon lucide-clock"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
                    <div>

                        <p class="text-sm font-semibold">@DateTime.Now.ToString("d 'de' MMMM 'del' yyyy", new CultureInfo("es-ES"))</p>
                        <p class="text-xs text-green-600">Fecha de creación del prestamo</p>

                    </div>
                </div>
                
                <div class="flex w-full gap-3 items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-700 lucide lucide-clock-alert-icon lucide-clock-alert"><path d="M12 6v6l4 2"/><path d="M20 12v5"/><path d="M20 21h.01"/><path d="M21.25 8.2A10 10 0 1 0 16 21.16"/></svg>            <div>

                        <p class="text-sm font-semibold">@DateTime.Now.AddDays(CreateLoanModel.MaxLoanDays).ToString("d 'de' MMMM 'del' yyyy", new CultureInfo("es-ES"))</p>
                        <p class="text-xs text-red-600">Fecha de vencimiento del prestamo</p>

                    </div>
                    
                   
                </div>
            </Animate>
        }
        @if (_creatingLoan)
        {
            <LumexSpinner Size="Size.Small" Variant="SpinnerVariant.Classic"/>
        }
        else
        {
            <LumexButton OnClick="SetDeleteGenreConfirmationModal" Class="mt-[20px]" Disabled="@(_creatingLoan || !context.Validate())" Color="ThemeColor.Primary">Crear Préstamo</LumexButton>

        }

    </div>
</EditForm>


@code{
     public LoanResponse _loanToInvoice {get; set;} = new();
    public bool ShowInvoice {get; set;} = false;
    public bool _creatingLoan {get; set;} = false;
    public bool _searchingBooks { get; set; } = false;
    public ReaderResponse Reader { get; set; } = new();
    public List<BookResponse> SearchedBooks {get; set;} = new();
    public CancellationTokenSource? _searchBookct { get; set; } = default;
    public string BookFilter {get; set;} = "";
    public List<BookResponse> SelectedBooks { get; set; } = new();
    public CreateLoanRequest CreateLoanModel { get; set; } = new();
    public RenderFragment _clockDangerIcon => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-300 lucide lucide-clock-alert-icon lucide-clock-alert"><path d="M12 6v6l4 2"/><path d="M20 12v5"/><path d="M20 21h.01"/><path d="M21.25 8.2A10 10 0 1 0 16 21.16"/></svg>;         



}

@functions{

    public async Task SetDeleteGenreConfirmationModal()
    {
        if(_creatingLoan) return;

        
        var confirmed = await DialogService.ShowAsync(
            title: "Crear Préstamo",
            body: $"¿Desea Crear el prestamo para {Reader.FullName}? Una vez creado este no se puede eliminar o actualizar. Si necesita modificar, marquelo como devuelto y cree otro.",
            acceptText: "Sí, Crear Préstamo",
            cancelText: "Cancelar",
                acceptColor: ThemeColor.Primary
            
        );

        if (confirmed)
        {
            await FetchCreateLoanAsync();
        }
    }
    public void ChangeMaxLoanDays(int number)
    {
        CreateLoanModel.MaxLoanDays += number;
    }

    public void HandleBookAdded(BookResponse book)
    {
        SelectedBooks.Insert(0, book);
        CreateLoanModel.BookIds = SelectedBooks.Select(b => b.Id).ToList();
    }
    
    public void HandleBookRemoved(BookResponse book)
    {
        var item = SelectedBooks.FirstOrDefault(b => b.Id == book.Id);

        if (item is null) return;
        
        SelectedBooks.Remove(item);
        CreateLoanModel.BookIds = SelectedBooks.Select(b => b.Id).ToList();

    }


    protected override async Task OnInitializedAsync()
    {
       await FetchGetBooksByName();
       CreateLoanModel.ReaderId = Reader.Id;
    }
    

    public async Task HandleSearchBookTextChanged(string value)
    {
        if(_searchingBooks) return;
        
        BookFilter = value;

        if (_searchBookct is not null)
        {
            await _searchBookct.CancelAsync();
        }

        try
        {
            _searchBookct = new();
            await Task.Delay(500, _searchBookct.Token);
            await FetchGetBooksByName();
        }
        catch
        {
            
        }
    }

    protected override void OnInitialized()
    {
        if (RightBarContext.State.ReaderToLoan is not null)
        {
            Reader = RightBarContext.State.ReaderToLoan;
        }

        StateHasChanged();
    }

    public async Task FetchGetBooksByName()
    {
        if(_searchingBooks) return;
        
        SearchedBooks.Clear();
        _searchingBooks = true;
        
        StateHasChanged();
        var result = await BooksApiServices.GetByFilterAsync(new(){Take = 3, BookName = BookFilter});

        if (result.IsSuccessful())
        {
            SearchedBooks.AddRange(result.Data);
        }

        _searchingBooks = false;
        StateHasChanged();
    }
  
    public async Task FetchCreateLoanAsync()
    {
        _creatingLoan = true;
        StateHasChanged();
        var result = await LoansApiServices.CreateAsync(CreateLoanModel);

        if (result.IsSuccessful())
        {
            Toast.Show("Prestamo creado con exito");
             CreateLoanModel = new();
            _loanToInvoice = result.Data;
            ShowInvoice = true;

        }
            _creatingLoan = false;
            StateHasChanged();
    }
   
    
}