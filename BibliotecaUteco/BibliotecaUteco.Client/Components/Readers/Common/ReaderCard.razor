@using BibliotecaUteco.Client.Utilities
<div class="w-full border-neutral-100 border rounded-xl  bg-neutral-50 hover:bg-neutral-100 flex  flex-col  gap-3 p-3  ">
    
   <div class="w-full gap-4 items-center flex ">
       <img class="w-[50px] h-[50px] rounded-full object-cover" src=@($"https://avatar.iran.liara.run/public/{Reader.SexName}?username={Reader.FullName}")/>
       <div class="flex flex-col gap-1 ">
           <label class="text-[16px] font-semibold opacity-80 text-black ">@Reader.FullName</label>
           <label class="text-[13px] font-normal ">Info: @Reader.IdentityCardNumber 
                   (@if (!string.IsNullOrEmpty(Reader.StudentLicence))
                   {
                       @Reader.StudentLicence
                       }
                       else
                       {
                       @(" -------")
                   })
           </label>

            
       </div>
       
       <LumexDropdown  Placement="PopoverPlacement.LeftStart"  ShowArrow="true" >
           <LumexDropdownTrigger>
                   <EllipsisVerticalIcon Size="18px" class="text-neutral-800 ml-auto"/>
           </LumexDropdownTrigger>
           <LumexDropdownMenu>
               <LumexDropdownItem OnClick="SetUpdateReaderView" Id="ActualizarLector">
                   <StartContent>
                       <SquarePenIcon Size="18px"/>
                   </StartContent>
                   <ChildContent>Actualizar lector</ChildContent>
               </LumexDropdownItem>
               <LumexDropdownItem Disabled="@(_deletingReader || Reader.LastLoanIsActive)" OnClick="SetDeleteReaderConfirmationModal" Id="EliminarLector" Color="ThemeColor.Danger" class="text-red-600">
                   <StartContent>
                       <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                   </StartContent>
                   <ChildContent>Eliminar lector</ChildContent>
               </LumexDropdownItem>
               <LumexDropdownItem Disabled="@(RightBarContext.State.ReaderToLoan is not null)" OnClick="SetCreateLoanView" Id="CrearPrestamo" >
                   <StartContent>
                       <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-handshake-icon lucide-handshake"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>                   </StartContent>
                   <ChildContent>Asignar préstamo</ChildContent>
               </LumexDropdownItem>

           </LumexDropdownMenu>
       </LumexDropdown>
       </div>

   <div class="w-full flex items-center gap-2">


       

       <div class="flex gap-2 items-center">
           <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin-house-icon lucide-map-pin-house"><path d="M15 22a1 1 0 0 1-1-1v-4a1 1 0 0 1 .445-.832l3-2a1 1 0 0 1 1.11 0l3 2A1 1 0 0 1 22 17v4a1 1 0 0 1-1 1z"/><path d="M18 10a8 8 0 0 0-16 0c0 4.993 5.539 10.193 7.399 11.799a1 1 0 0 0 .601.2"/><path d="M18 22v-3"/><circle cx="10" cy="10" r="3"/></svg>
           <label class="text-[13px] font-semibold "> @Reader.Address</label>
       </div>
       <hr class="border border-neutral-300 rounded-full h-[10px]"/>
       <div class="flex gap-2 items-center">
           <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone-icon lucide-phone"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
           <label class="text-[13px] font-semibold "> @Reader.FormattedPhoneNumber</label>

       </div>



   </div>
   <SidebarSectionDivider Name="Detalles de préstamos"/>

   <div class="w-full flex items-center gap-2">
       <LumexChip Color="ThemeColor.Secondary" Variant="ChipVariant.Flat" Class="px-2">
           <StartContent>
               <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-spline-icon lucide-chart-spline"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M7 16c.5-2 1.5-7 4-7 2 0 2 3 4 3 2.5 0 4.5-5 5-7"/></svg>
           </StartContent>
           <ChildContent>
               @Reader.LoansCount Prestamos pedidos
           </ChildContent>
       </LumexChip>
      

   </div>
   



</div>

@code{

    public bool _deletingReader {get; set;} = false;

    [Parameter]
    public EventCallback<ReaderResponse> OnDelete {get; set;}
    
    public async Task SetDeleteReaderConfirmationModal()
    {
        if(_deletingReader) return;

        
        var confirmed = await DialogService.ShowAsync(
            title: "Eliminar Lector",
            body: $"¿Desea eliminar el lector {Reader.FullName}? Una vez eliminado no se podrá recuperar. No se pueden eliminar los lectores con prestamos activos o lectores con penalizaciones sin pagar.",
            acceptText: "Sí, eliminar lector",
            cancelText: "Cancelar"
            
        );

        if (confirmed)
        {
            await FetchDeleteReaderAsync();
        }
    }


    public async Task FetchDeleteReaderAsync()
    {
        _deletingReader = true;
        StateHasChanged();

        var result = await ReadersApiServices.DeleteAsync(new(){ReaderId = Reader.Id});

        if(result.IsSuccessful())
        {
            Toast.Show("Lector eliminado exitosamente");
            await OnDelete.InvokeAsync(Reader);
        }

        _deletingReader = false;
        StateHasChanged();
    }

    public async Task SetUpdateReaderView()
    {
        await RightBarContext.OpenUpdateReaderAsync(Reader);

       

        
    }
    
    public async Task SetCreateLoanView()
    {
        await RightBarContext.SetReaderToLoan(Reader);
    }
    

    [Parameter]
    public ReaderResponse Reader { get; set; } = new();

}