<EditForm Model="UpdateReaderModel" OnValidSubmit="FetchUpdateReaderAsync"
          class="flex w-full absolute flex-col justify-center">
    <DataAnnotationsValidator/>
    <div class="w-full flex flex-col gap-3 p-3 mt-[40px] ">

        <label class="font-normal text-[13px]">Actualiza los datos de un lector en nuestro sistema. Los campos con el
            asterisco rojo (<span class="text-red-600">*</span>) son obligatorios.</label>


        <div>
            <LumexTextbox Behavior="InputBehavior.OnInput" Required="true" Type="InputType.Text"
                          @bind-Value="UpdateReaderModel.FullName" Label="Nombre completo" Disabled="_updatingReader"
                          Description="Máximo 50 caracteres. Mínimo 15."
                          PlaceHolder="Ej. Jose Manuel López"></LumexTextbox>
            <p class="text-red-500 text-xs">
                <ValidationMessage For="@(() => UpdateReaderModel.FullName)"/>
            </p>
        </div>
        <div>
            <LumexTextbox Behavior="InputBehavior.OnInput" Required="true" Type="InputType.Telephone"
                          @bind-Value="UpdateReaderModel.PhoneNumber" Label="Número de teléfono"
                          Description="Solo números sin guiones." PlaceHolder="8090000000"
                          Disabled="_updatingReader"></LumexTextbox>
            <p class="text-red-500 text-xs">
                <ValidationMessage For="@(() => UpdateReaderModel.PhoneNumber)"/>
            </p>
        </div>
        <div>
            <LumexTextbox Behavior="InputBehavior.OnInput" Required="true" Type="@InputType.Text"
                          @bind-Value="UpdateReaderModel.Address" Label="Dirección física"
                          Description="Donde vive el lector" PlaceHolder="Ej. La Cueva, Cotuí"
                          Disabled="_updatingReader"></LumexTextbox>
            <p class="text-red-500 text-xs">
                <ValidationMessage For="@(() => UpdateReaderModel.Address)"/>
            </p>
        </div>
        <div>
            <LumexTextbox Behavior="InputBehavior.OnInput" Type="InputType.Text"
                        ValueChanged="HandleOnIdentityNumberInput"
                          Value="@UpdateReaderModel.IdentityCardNumber" Label="Cédula de identificación"
                          Description="Sin guiones, solo los números." PlaceHolder="Ej. 000000000000"
                          Disabled="_updatingReader"></LumexTextbox>
            <p class="text-red-500 text-xs">
                <ValidationMessage For="@(() => UpdateReaderModel.IdentityCardNumber)"/>
            </p>
        </div>

        <div class="flex flex-col">
            <LumexTextbox Behavior="InputBehavior.OnInput" Disabled="_updatingReader" Required="false"
                          Type="InputType.Text" Value="@UpdateReaderModel.Passport" ValueChanged="(e)=> {HandleOnPassportInputChanged(e);}"
                          Label="Pasaporte" Description="Introduzca el numero de su pasaporte (opcional)."
                          PlaceHolder="Ej. B11111000"></LumexTextbox>
            <p class="text-red-500 text-xs">
                <ValidationMessage For="@(() => UpdateReaderModel.Passport)"/>
            </p>
        </div>

        <div>
            <LumexTextbox Behavior="InputBehavior.OnInput" Required="false" Type="InputType.Text"
                          Value="@UpdateReaderModel.StudentLicence"
                          ValueChanged="(e) => {HandleOnStudentLicenceInput(e);}"
                          Label="Matrícula universitaria (si aplica)"
                          Description="Opcional. Solo para estudiantes. Introduce el guión donde requiere."
                          PlaceHolder="Ej. 0000-0000" Disabled="_updatingReader"></LumexTextbox>
            <p class="text-red-500 text-xs">
                <ValidationMessage For="@(() => UpdateReaderModel.StudentLicence)"/>
            </p>
        </div>

        <LumexSelect Size="Size.Small" TValue="@(ApplicationSexes)"
                     @bind-Value="@UpdateReaderModel._sex"
                     Disabled="_updatingReader"
                     Label="Sexo del usuario"
                     Placeholder="Selecciona el sexo del usuario"
                     Class="max-w-xs">

            <LumexSelectItem @key="@(ApplicationSexes.Masculino)" Value="@(ApplicationSexes.Masculino)">
                Masculino
            </LumexSelectItem>
            <LumexSelectItem @key="@(ApplicationSexes.Femenino)" Value="@(ApplicationSexes.Femenino)">

                Femenino
            </LumexSelectItem>

        </LumexSelect>

        <SectionDivider/>
        @if (_updatingReader)
        {
            <LumexSpinner Variant="SpinnerVariant.Classic" Size="Size.Small"/>
        }
        else
        {
            <LumexButton Color="ThemeColor.Primary" Type="ButtonType.Submit"
                         Disabled="@(!context.Validate() || _updatingReader)">Actualizar Lector
            </LumexButton>
        }


    </div>
</EditForm>

@code{

    public bool _updatingReader { get; set; } = false;
    public UpdateReaderRequest UpdateReaderModel { get; set; } = new();


}

@functions{

    public void HandleOnIdentityNumberInput(string? e)
    {
        var value = e ?? string.Empty;
        if (value == string.Empty)
        {
            UpdateReaderModel.IdentityCardNumber = null;
            return;
        }

        UpdateReaderModel.IdentityCardNumber = value;
        return;
    }
    public void HandleOnStudentLicenceInput(string? e)
    {
        var value = e ?? string.Empty;
        if (value == string.Empty)
        {
            UpdateReaderModel.StudentLicence = null;
            return;
        }

        UpdateReaderModel.StudentLicence = value;
        return;
    }

     public void HandleOnPassportInputChanged(string? e)
    {
        var value = e ?? string.Empty;
        if (value == string.Empty)
        {
            UpdateReaderModel.Passport = null;
            return;
        }

        UpdateReaderModel.Passport = value;
        return;
    }

    public void ParseReaderToUpdate(ReaderResponse reader)
    {
        UpdateReaderModel.FullName = reader.FullName;
        UpdateReaderModel._sex = SexParser.ParseSex(reader.SexId);
        UpdateReaderModel.PhoneNumber = reader.PhoneNumber;
        UpdateReaderModel.FullName = reader.FullName;
        UpdateReaderModel.StudentLicence = reader.StudentLicence;
        UpdateReaderModel.IdentityCardNumber = reader.IdentityCardNumber;
        UpdateReaderModel.ReaderId = reader.Id;
        UpdateReaderModel.Address = reader.Address;
        UpdateReaderModel.Passport = reader.Passport;
    }

    protected override void OnInitialized()
    {
        if (RightBarContext.State.ReaderToUpdate is not null)
        {
            ParseReaderToUpdate(RightBarContext.State.ReaderToUpdate);
        }

        StateHasChanged();
    }

    public async Task FetchUpdateReaderAsync()
    {
        _updatingReader = true;
        StateHasChanged();

        var result = await ReadersApiServices.UpdateAsync(UpdateReaderModel);

        if (result.IsSuccessful())
        {
            await Toast.Show("Lector actualizado exitosamente");
            await RightBarContext.SetUpdatedReaderAsync(result.Data);
           
            await RightBarContext.CloseAsync();
            UpdateReaderModel = new UpdateReaderRequest();
        }


        _updatingReader = false;
        StateHasChanged();
    }


}