<AuthorizeView>
    <Authorized>
        <LumexDropdown ShowArrow="true">
            <LumexDropdownTrigger>
                <div class="relative w-full group aspect-[2/3]">
                    <img src="@Book.CoverUrl"
                         class="opacity-0 group-hover:opacity-50 h-full aspect-[2/3] blur-xl transition-all  object-cover brightness-75 absolute"/>
                    <Animate Animation="Animations.FadeIn" Delay="TimeSpan.FromMilliseconds(Index * 300)">
                        <LumexCard Class="group relative group aspect-[2/3] w-full cursor-pointer transition-all ">

                            <div class="w-full z-[10] flex absolute p-2 justify-between gap-10 items-center">
                                <div class="px-3 py-1 w-fit rounded-full bg-neutral-800/50 backdrop-blur-md">
                                    @if (Book.AvailableAmount >= 1)
                                    {
                                        <p class="text-xs font-semibold text-nowrap text-blue-500">@Book.AvailableAmount disponibles</p>
                                    }
                                    else
                                    {
                                        <p class="text-xs font-semibold text-nowrap text-red-500">No disponibles</p>
                                    }

                                </div>

                            </div>



                            @if (string.IsNullOrEmpty(Book.CoverUrl))
                            {
                                <div
                                    class="h-full w-full bg-neutral-950 object-contain">

                                </div>
                            }
                            else
                            {
                                <img src="@Book.CoverUrl"
                                     class="h-full w-full object-cover brightness-75"

                                     alt="Card background"/>
                            }

                            <LumexCardFooter Blurred="@true" Class="absolute bottom-0 z-10 bg-orange-100/30">
                                <div class="text-small flex flex-grow flex-col gap-1 text-white">
                                    <p class="line-clamp-1 font-semibold">@Book.Name</p>

                                    <div class="w-full flex gap-1 justify-between">
                                        <p class="line-clamp-1 opacity-80 text-xs font-medium">


                                            @if (Book.Authors.Any())
                                            {
                                                @(Book.Authors.First().Author.FullName)
                                            }


                                        </p>
                                        @if (Book.Authors.Count() >= 2)
                                        {
                                            <p class="line-clamp-1 opacity-50 text-xs font-medium">
                                                +@($"{Book.Authors.Count() - 1}")</p>
                                        }
                                    </div>


                                </div>

                            </LumexCardFooter>
                        </LumexCard>
                    </Animate>
                </div>

            </LumexDropdownTrigger>
            <LumexDropdownMenu>


                <LumexDropdownItem OnClick="SetBookToUpdate" Id="EditarLibro">
                    <StartContent>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-book-image-icon lucide-book-image !size-[18px]">
                            <path d="m20 13.7-2.1-2.1a2 2 0 0 0-2.8 0L9.7 17"/>
                            <path
                                d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/>
                            <circle cx="10" cy="8" r="2"/>
                        </svg>
                    </StartContent>
                    <ChildContent>Editar Libro</ChildContent>
                </LumexDropdownItem>

                <LumexDropdownItem OnClick="SetBookDetails" Id="VerDetalles">
                    <StartContent>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-badge-info-icon lucide-badge-info !size-[18px]">
                            <path
                                d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
                            <line x1="12" x2="12" y1="16" y2="12"/>
                            <line x1="12" x2="12.01" y1="8" y2="8"/>
                        </svg>
                    </StartContent>
                    <ChildContent>Ver detalles</ChildContent>
                </LumexDropdownItem>
                <LumexDropdownItem Disabled="@(string.IsNullOrEmpty(Book.CoverUrl))" OnClick="ViewBookCover"
                                   Id="BookCover">
                    <StartContent>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-image-icon lucide-image">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                            <circle cx="9" cy="9" r="2"/>
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                        </svg>
                    </StartContent>
                    <ChildContent>Ver Portada</ChildContent>
                </LumexDropdownItem>


                <LumexDropdownItem Id="Divider2" Disabled="true">
                    <SectionDivider Name="Zona de peligro"/>
                </LumexDropdownItem>
                <LumexDropdownItem OnClick="SetDeleteBookConfirmationModal" Disabled="_deletingBook" Id="EliminarLibro"
                                   Color="@ThemeColor.Danger" Class="text-danger">
                    <StartContent>
                        <Trash2Icon Size="18" class="shrink-0"/>
                    </StartContent>
                    <ChildContent>Eliminar libro</ChildContent>
                </LumexDropdownItem>


            </LumexDropdownMenu>
        </LumexDropdown>
    </Authorized>
</AuthorizeView>






@code{


    //flags

    public bool ShowDeleteBookConfirmationDialog { get; set; } = false;
    public bool _deletingBook { get; set; } = false;
    [Parameter] public BookResponse Book { get; set; } = new();

    [Parameter] public bool HideShowDetails { get; set; }

    [Parameter] public int Index { get; set; } = 1;

    [Parameter] public EventCallback OnBookDeleted { get; set; }

    public async Task ViewBookCover()
    {
        await LightBoxService.ShowAsync(Book.Name, Book.CoverUrl);
    }

    public async Task FetchDeleteBookAsync()
    {
        if (Book.Id <= 0) return;

        _deletingBook = true;
        StateHasChanged();
        var result = await BooksApiServices.DeleteBookAsync(new DeleteBookRequest { BookId = Book.Id });

        if (result.IsSuccessful())
        {
            await Toast.Show("Libro eliminado exitosamente.");
            await OnBookDeleted.InvokeAsync();
        }

        _deletingBook = false;
        ShowDeleteBookConfirmationDialog = false;
        StateHasChanged();
    }

    public async Task SetDeleteBookConfirmationModal()
    {
        if (_deletingBook) return;


        var confirmed = await DialogService.ShowAsync(
            "Eliminar Libro",
            $"¿Desea eliminar el libro {Book.Name}? Una vez eliminado no se podrá recuperar.",
            "Sí, eliminar libro",
            "Cancelar"
        );

        if (confirmed)
        {
            await FetchDeleteBookAsync();
        }
    }

    public async Task SetBookToUpdate()
    {
        await RightBarContext.OpenUpdateBookAsync(Book);
    }

    public async Task SetBookDetails()
    {
        await RightBarContext.OpenBookDetailsAsync(Book);
    }

}