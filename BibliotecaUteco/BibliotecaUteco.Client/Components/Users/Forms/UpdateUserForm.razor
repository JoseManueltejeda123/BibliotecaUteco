@using BibliotecaUteco.Client.Utilities
<EditForm  Model="UpdateUserModel"  class="flex w-full absolute flex-col justify-center">
    <DataAnnotationsValidator/>
    <div class="w-full flex flex-col gap-3 p-3 mt-[40px] ">
        <InputFile accept=".jpg,.jpeg,.png,.webp" @ref="fileInput" class="hidden" OnChange="HandleFileChange"/>
        
        @if (!string.IsNullOrEmpty(_prevProfilePicture))
        {
            <div class="w-full flex flex-col items-center">
                <img  class="w-[50%] aspect-[2/3] object-cover rounded-sm" src="@_prevProfilePicture" />

            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(ProfilePicturePreview) && UpdateUserModel.ProfilePictureFile is not null)
            {
                <div class="w-full flex flex-col items-center">
                    <img  class="w-[50%] aspect-[2/3] object-cover rounded-sm" src="@_prevProfilePicture ?? ProfilePicturePreview " />

                </div>
            }
            else
            {
                <div class="w-full flex flex-col items-center">
                    <img class="w-[70px] h-[70px] rounded-full object-cover" src=@($"https://hostedboringavatars.vercel.app/api/beam?name={UpdateUserModel.Username}") />

                </div>
          
            }
        }
        
       
        @if (!string.IsNullOrEmpty(_prevProfilePicture))
        {

            <LumexButton Size="Size.Small" Variant="Variant.Light" Color="ThemeColor.Danger" OnClick="()=>{_prevProfilePicture = null;}">Eliminar Foto</LumexButton>
        }
        else
        {
            @if (!string.IsNullOrEmpty(ProfilePicturePreview) || UpdateUserModel.ProfilePictureFile is not null)
            {

                <LumexButton Size="Size.Small" Variant="Variant.Light" Color="ThemeColor.Danger" OnClick="RemovePicture">Eliminar Foto</LumexButton>
            }
            else
            {
                <LumexButton Size="Size.Small" Variant="Variant.Light" Color="ThemeColor.Primary" OnClick="TriggerFileInput">Subir Foto</LumexButton>

            }
        }

        
        
        <div class="flex flex-col ">
            <LumexTextbox  Size="Size.Small" Behavior="InputBehavior.OnInput" Required="true" Type="InputType.Text" @bind-Value="UpdateUserModel.FullName" Label="Nombre completo" Description="Máximo 50 caracteres. Mínimo 15." PlaceHolder="Ej. Jose Manuel López"></LumexTextbox>
            <span class="text-[13px] text-red-700"><ValidationMessage For="@(() => UpdateUserModel.FullName)"/></span>

        </div>
        <div class="flex flex-col ">
            <LumexTextbox  Size="Size.Small" Behavior="InputBehavior.OnInput" Disabled="_updatingUser" Required="true" Type="InputType.Text" @bind-Value="UpdateUserModel.Username" Label="Nombre de usuario" Description="Máximo 15 caracteres. Mínimo 5. Solo letras, numeros, raya baja y punto." PlaceHolder="Ej. Manuel.Lopez1"></LumexTextbox>
            <span class="text-[13px] text-red-700"><ValidationMessage For="@(() => UpdateUserModel.Username)"/></span>


        </div>
      
        <div class="flex flex-col ">
            <LumexTextbox Size="Size.Small" Behavior="InputBehavior.OnInput" Disabled="_updatingUser" Required="true" Type="InputType.Text" @bind-Value="@UpdateUserModel.IdentityCardNumber" Label="Cédula de identificación" Description="Sin guiones, solo los números." PlaceHolder="Ej. 000000000000"></LumexTextbox>
            <span class="text-[13px] text-red-700"><ValidationMessage For="@(() => UpdateUserModel.IdentityCardNumber)"/></span>


        </div>
        <LumexSelect Size="Size.Small" TValue="@(ApplicationSexes)"
                     @bind-Value="@UpdateUserModel._sex"
                     Label="Sexo del usuario"
                     Placeholder="Selecciona el sexo del usuario"
                     Class="max-w-xs">
           
            <LumexSelectItem @key=@(ApplicationSexes.Masculino) Value=@(ApplicationSexes.Masculino)>
                Masculino
            </LumexSelectItem>
            <LumexSelectItem @key=@(ApplicationSexes.Femenino) Value=@(ApplicationSexes.Femenino)>
                                                      
                Femenino
            </LumexSelectItem>
            
        </LumexSelect>
        <AuthorizeView >
            <Authorized Context="password">
                @if (!string.IsNullOrEmpty(password.User?.FindFirst(JwtRegisteredClaimNames.Sub)?.Value) && UpdateUserModel.UserId.ToString() == password.User?.FindFirst(JwtRegisteredClaimNames.Sub)?.Value)
                {
                    <SectionDivider Name="Opcional"/>
                    <div class="flex flex-col ">
                        <LumexTextbox Size="Size.Small" Behavior="InputBehavior.OnInput" Disabled="_updatingUser" Required="false" Type="InputType.Password" @bind-Value="@UpdateUserModel.CurrentPassword" Label="Su contraseña actual" Description="Introdzca la contraseña actual" PlaceHolder="*******"></LumexTextbox>
                        <span class="text-[13px] text-red-700"><ValidationMessage For="@(() => UpdateUserModel.CurrentPassword)"/></span>
                    </div>
                    <div class="flex flex-col ">
                        <LumexTextbox Size="Size.Small" Behavior="InputBehavior.OnInput" Disabled="_updatingUser" Required="false" Type="InputType.Password" @bind-Value="@UpdateUserModel.NewPassword" Label="Su contraseña nueva" Description="Introdzca la contraseña nueva" PlaceHolder="*******"></LumexTextbox>
                        <span class="text-[13px] text-red-700"><ValidationMessage For="@(() => UpdateUserModel.NewPassword)"/></span>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
        <SectionDivider/>
        @if (_updatingUser)
        {
            <LumexSpinner Variant="SpinnerVariant.Classic" Size="Size.Small"/>
        }
        else
        {
            <LumexButton Color="ThemeColor.Primary" OnClick="FetchUpdateUserAsync" Disabled="@(!context.Validate() || _updatingUser)">Guardar Cambios</LumexButton>

        }
        
       


    </div>
</EditForm>

@code{

    public bool _updatingUser { get; set; } = false;
    public UpdateUserRequest UpdateUserModel { get; set; } = new();
    public string? ProfilePicturePreview { get; set; } = null;
    private InputFile? fileInput = null;
    public bool ShowPassword { get; set; } = false;
    public string? _prevProfilePicture {get; set;} = null;



}

@functions{

    public void ParseUserToUpdate(UserResponse user)
    {
        UpdateUserModel.UserId = user.Id;
        UpdateUserModel.Username = user.Username;
        UpdateUserModel.FullName = user.FullName;
        UpdateUserModel._sex = SexParser.ParseSex(user.SexId);
        UpdateUserModel.IdentityCardNumber = user.IdentityCardNumber;
        _prevProfilePicture = user.ProfilePictureUrl;
    }
    protected override void OnInitialized()
    {
       
        if (RightBarContext.State.UserToUpdate is not null)
        {

            ParseUserToUpdate(RightBarContext.State.UserToUpdate);

        }
        StateHasChanged();
       
    }

    public async Task FetchUpdateUserAsync()
    {
        _updatingUser = true;
        StateHasChanged();

        UpdateUserModel.RemoveProfilePicture = UpdateUserModel.ProfilePictureFile is null && string.IsNullOrEmpty((_prevProfilePicture));
        var result = await UsersApiServices.UpdateAsync(UpdateUserModel);

        if (result.IsSuccessful())
        {
            Toast.Show("Usuario actualizado exitosamente");
         
            UpdateUserModel = new();
            await Task.WhenAny(RightBarContext.CloseAsync());
        }
        
        
        _updatingUser = false;
        StateHasChanged();
    }
    public void RemovePicture()
    {
        ProfilePicturePreview = null;
        UpdateUserModel.ProfilePictureFile = null;
    }
    
    public async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        var result = await FileHandler.HandleImageFromInputAsync(e);
        if (result.Item1 is null)
        {
            Toast.Error("Error al subir la imagen", new ToastModel()
            {
                Description = result.Item2
            });

            return;
        }

        UpdateUserModel.ProfilePictureFile = result.Item1;
        ProfilePicturePreview = result.Item2;
        StateHasChanged();

    }
    
    private async Task TriggerFileInput()
    {
        await JsRuntime.InvokeVoidAsync("triggerClick", fileInput?.Element);
    }
    
    public void SwitchPasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }
    
}