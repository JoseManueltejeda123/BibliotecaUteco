<div class="w-full rounded-xl bg-neutral-50 border border-neutral-100">
    <ul>
        @foreach (var user in Users)
        {
            <UserCard User="user" @key="user.Id"/>
            @if(user != Users.Last())
            {
                <LumexDivider/>
            }
        }
    </ul>
</div>


@code{

    
    [Parameter]
    public List<UserResponse> Users {get; set;} = new();

}