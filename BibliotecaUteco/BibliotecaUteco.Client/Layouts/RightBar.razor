@implements  IDisposable

<aside class=@($"fixed bg-white overflow-x-hidden max-md:z-50  right-0  h-screen max-h-[100vh]  overflow-y-auto  h-full w-[350px]   flex flex-col items-center  border-l border-neutral-300")>
    <div class="w-full flex sticky top-0  bg-neutral-100/50 px-3 py-2 backdrop-blur-md gap-2 font-semibold   z-[100] items-center">
        
        <button @onclick="CloseAsync" >
            <CircleXFilledIcon  Size="20px"/>

        </button>
        <p class="text-neutral-900 opacity-80 text-[13px]">
            @(RightBarContext.State.View switch
            {

            RightBarView.CreatingBook => "Registrar Libro",
            RightBarView.UpdateBook => "Actualizar Libro",
            RightBarView.BookDetails => "Acerca del libro",
            RightBarView.Users => "Administrar Usuarios",
            RightBarView.UpdateUser => "Actualizar Usuario",
            RightBarView.CreateUser => "Crear Usuario",
            RightBarView.CreateReader => "Crear Lector",
            RightBarView.UpdateReader => "Actualizar Lector",
            RightBarView.CreateLoan => "Crear Prestamo",


            _ => ""
            })
        </p>
        
       
    </div>
    @if (RightBarContext.State.View == RightBarView.CreatingBook)
    {
        <CreateBookForm/>
    }
    else if (RightBarContext.State.View == RightBarView.UpdateBook)
    {
        <UpdateBookForm/>
    }
    else if(RightBarContext.State.View == RightBarView.BookDetails)
    {
        <BookDetails/>
    }
    else if (RightBarContext.State.View == RightBarView.Users)
    {
        <AuthorizeView Roles="Admin">
            <Authorized>
                <UsersView/>
    
            </Authorized>
            <NotAuthorized>
                <div class="absolute w-full h-full flex flex-col gap-2 items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-off-icon lucide-circle-off"><path d="m2 2 20 20"/><path d="M8.35 2.69A10 10 0 0 1 21.3 15.65"/><path d="M19.08 19.08A10 10 0 1 1 4.92 4.92"/></svg>
                    <p class="text-md font-semibold">No estas autorizado par acceder aquí</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
    else if (RightBarContext.State.View == RightBarView.CreateUser)
    {
        <AuthorizeView Roles="Admin">
            <Authorized>
                <CreateUserForm/>
    
            </Authorized>
            <NotAuthorized>
                <div class="absolute w-full h-full flex flex-col gap-2 items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-off-icon lucide-circle-off"><path d="m2 2 20 20"/><path d="M8.35 2.69A10 10 0 0 1 21.3 15.65"/><path d="M19.08 19.08A10 10 0 1 1 4.92 4.92"/></svg>
                    <p class="text-md font-semibold">No estas autorizado par acceder aquí</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
    else if(RightBarContext.State.View == RightBarView.UpdateUser)
    {
        <AuthorizeView Roles="Admin">
            <Authorized>
                <UpdateUserForm/>
    
            </Authorized>
            <NotAuthorized>
                <div class="absolute w-full h-full flex flex-col gap-2 items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-off-icon lucide-circle-off"><path d="m2 2 20 20"/><path d="M8.35 2.69A10 10 0 0 1 21.3 15.65"/><path d="M19.08 19.08A10 10 0 1 1 4.92 4.92"/></svg>
                    <p class="text-md font-semibold">No estas autorizado par acceder aquí</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    }
    else if(RightBarContext.State.View == RightBarView.CreateReader)
    {
        <CreateReaderForm/>
    }
    else if(RightBarContext.State.View == RightBarView.UpdateReader)
    {
        <UpdateReaderForm/>
    }
    else if(RightBarContext.State.View == RightBarView.CreateLoan)
    {
        <CreateLoanForm/>
    }
    
</aside>
@code {

    public async Task CloseAsync()
    {
       await RightBarContext.CloseAsync();
    }

    protected override void OnInitialized()
    {
        RightBarContext.OnStateChanged += HandleStateChanged;
    }

    public async void HandleStateChanged(RightBarState state)
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RightBarContext.OnStateChanged -= HandleStateChanged;;
    }
}