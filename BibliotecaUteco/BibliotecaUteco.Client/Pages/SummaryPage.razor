@page "/summary"
@using BibliotecaUteco.Client.Components.Reports

<AllowAdminsOnly/>

<div class="flex flex-col w-full mt-[20px] gap-4 px-4">
   
    @if(_showInvoice)
    {
        <GeneralReportInvoice Model="GeneralReportResponse" OnPrinted="SetShowInvoice"/>
    }
    @if(CurrentReportView is null)
    {
        <div class="flex w-full items-center gap-2 justify-between">
            <h2 class="text-3xl font-semibold">Reportes</h2>

            <LumexPopover ShowArrow="true" Placement="PopoverPlacement.Bottom">
                <LumexPopoverTrigger>
                     <LumexChip Class="cursor-pointer p-2" Size="Size.Medium"  Color="@ThemeColor.Info" Variant="ChipVariant.Flat">
                        <EndContent>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-printer-icon lucide-printer"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>                
                        </EndContent>
                    <ChildContent>Imprimir reporte general</ChildContent>

                    </LumexChip>
          
                </LumexPopoverTrigger>
                <LumexPopoverContent>
                <div class="w-full flex flex-col gap-1 p-3">
                    <p class="text-[14px] font-semibold opacity-80 mb-4">Selecciona la fecha del reporte a generar</p>
                    
                    <YearPicker SelectedYear="GeneralReportModel.Year" OnYearChanged="(e)=>{ GeneralReportModel.Year = e ?? DateTime.Now.Year;}" />
                    <MonthsPicker SelectedMonth="GeneralReportModel.Month ?? DateTime.Now.Month" OnMonthChanged="(e)=>{GeneralReportModel.Month = e;}"/>
                    <SectionDivider/>
                    
                    <LumexButton OnClick="FetchGetGeneralReportByMonthAsync" Color="ThemeColor.Primary"  Disabled="_fetchingInvoice">
                        @if(_fetchingInvoice)
                        {

                            <LumexSpinner Size="Size.Small" Color="ThemeColor.Default" Variant="SpinnerVariant.Classic"/>
                        }
                        else
                        {
                            @("Imprimir Reporte")
                        }
                    </LumexButton>
                    <LumexButton OnClick="FetchGetGeneralReportByYearAsync" Variant="Variant.Flat" Color="ThemeColor.Secondary" Disabled="_fetchingInvoice"> 
                        @if(_fetchingInvoice)
                        {

                            <LumexSpinner Size="Size.Small" Color="ThemeColor.Primary" Variant="SpinnerVariant.Classic"/>
                        }
                        else
                        {
                            @("Imprimir Anual")
                        }
                    </LumexButton>

                </div>
                
                </LumexPopoverContent>
            </LumexPopover>
           
        </div>
        <SectionDivider Name="Opciones de reportes"/>
        <div class="flex flex-col gap-2 w-full">

            @foreach (var reportType in ReportKinds)
            {
                <div @onclick="()=>{ SetReportView(reportType.Type);}" class="group report-card w-full rounded-lg hover:text-green-700 hover:bg-neutral-200/30 cursor-pointer bg-neutral-50 border-neutral-100 border transition-all p-3 flex items-center gap-3">
                    @reportType.Icon
                    <p class="text-[13px] font-semibold line-clamp-1">@reportType.Name</p>
                </div>
            }

        </div>
    }
    else
    {
           
        @switch(CurrentReportView)
        {
            case ReportType.TopBooks:
                    <TopBooksView OnClose="()=>{SetReportView(null);}"/>
                    break;
            case ReportType.LoansPerMonth:
                    <LoansPerMonthView OnClose="()=>{SetReportView(null);}"/>
                break;
            
        }
    }
  
   
    

   
</div>

@code {

    public List<ReportKind> ReportKinds { get; set; } = new();
    public ReportType? CurrentReportView { get; set; } = null;

    public bool _showInvoice {get; set;}
    GetGeneralReportRequest GeneralReportModel {get; set;} = new();
    GeneralReport GeneralReportResponse {get; set;} = new();

    public bool _fetchingInvoice {get; set;}

}

@functions{

    public void SetShowInvoice()
    {
        _showInvoice = !_showInvoice;
    }
    protected override void OnInitialized()
    {
        ReportKinds = new()
        {
            new()
            {
                Name = "Top 10 libros más prestados",
                Icon = @<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:text-green-700 lucide lucide-chart-spline-icon lucide-chart-spline"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M7 16c.5-2 1.5-7 4-7 2 0 2 3 4 3 2.5 0 4.5-5 5-7"/></svg>,
                Type = ReportType.TopBooks
            },
            new()
            {
                Name = "Prestamos por mes",
                Icon = @<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days-icon lucide-calendar-days"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>,
                Type = ReportType.LoansPerMonth
            },
            
        };
    }

    public async Task FetchGetGeneralReportByMonthAsync()
    {
        _fetchingInvoice = true;
        StateHasChanged();
        var result = await ReportsApiServices.GetGeneralAsync(GeneralReportModel);

        if(result.IsSuccessful())
        {
             GeneralReportResponse = result.Data;
                     await JsRuntime.InvokeVoidAsync("console.log", result);

        }


        SetShowInvoice();

        _fetchingInvoice = false;
        StateHasChanged();
    }
   
   public async Task FetchGetGeneralReportByYearAsync()
   {
        _fetchingInvoice = true;
        StateHasChanged();
        GeneralReportModel.Month = null;
      var result = await ReportsApiServices.GetGeneralAsync(GeneralReportModel);
        await JsRuntime.InvokeVoidAsync("console.log", result);

      if(result.IsSuccessful())
      {
        GeneralReportResponse = result.Data;
      }
        
      SetShowInvoice();

      _fetchingInvoice = false;
        StateHasChanged();
   }
    public void SetReportView(ReportType? type)
    {
        CurrentReportView = type;
    }


    public enum ReportType
    {
        TopBooks,
        LoansPerMonth
    }

    public class ReportKind()
    {
        public string Name { get; set; } = "";
        public RenderFragment Icon {get; set;}
        public ReportType Type { get; set; }

    }




}