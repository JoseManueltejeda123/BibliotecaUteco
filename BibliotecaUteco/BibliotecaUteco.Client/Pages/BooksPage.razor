@page "/books"
@implements IDisposable
<PageTitle>Libros</PageTitle>

<div class="flex flex-col   w-full mt-[20px] gap-4 px-4">

   

            <div class="flex w-full items-center gap-2 justify-between">
                <h2 class="text-3xl font-semibold">Libros</h2>

               
                

                 <div class=" flex gap-3 items-center">
                    <GenresDropdown>
                        <LumexChip Class="cursor-pointer p-2" Size="Size.Medium"  Color="@ThemeColor.Primary" Variant="ChipVariant.Flat">
                            <EndContent>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tag-icon lucide-tag"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                            </EndContent>
                            <ChildContent>Géneros</ChildContent>
                        </LumexChip>
                    </GenresDropdown>
                    <AuthorsDropdown>
                        
                        <LumexChip Class="cursor-pointer p-2" Size="Size.Medium"  Color="@ThemeColor.Primary" Variant="ChipVariant.Flat">
                            <EndContent>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-tool-icon lucide-pen-tool"><path d="M15.707 21.293a1 1 0 0 1-1.414 0l-1.586-1.586a1 1 0 0 1 0-1.414l5.586-5.586a1 1 0 0 1 1.414 0l1.586 1.586a1 1 0 0 1 0 1.414z"/><path d="m18 13-1.375-6.874a1 1 0 0 0-.746-.776L3.235 2.028a1 1 0 0 0-1.207 1.207L5.35 15.879a1 1 0 0 0 .776.746L13 18"/><path d="m2.3 2.3 7.286 7.286"/><circle cx="11" cy="11" r="2"/></svg>
                            </EndContent>
                            <ChildContent>Autores</ChildContent>
                        </LumexChip>
                    
                    </AuthorsDropdown>
                </div>
            </div>
           
            
            <EditForm Model="Filter" OnValidSubmit="FetchGetBooksOnSearchAsync"  class="flex w-full gap-2 items-center text-black">
                <DataAnnotationsValidator/>
                <div class="w-full flex flex-col gap-1">
                    <LumexTextbox Type="@InputType.Search"
                                 StartContent="@_filterContainer"
                                  Label="Buscar libro"
                                  Behavior="InputBehavior.OnInput"
                                  Clearable="true"
                                  ValueChanged="async (e) => {await HandleOnChange(context.Validate(), e); }"
                                  OnCleared="FetchGetBooksOnSearchAsync"
                                  Required="false"
                                  Disabled="@(_searchingBooks)"
                                  Value="@Filter.Filter"
                                  Placeholder=@(filterPlaceholder)
                                  maxLenght="50"
                                  LabelPlacement="@LabelPlacement.Outside">
                       
                    </LumexTextbox>
                    
                   
                    <p class="text-[13px]">Seleciona un filtro de abajo para activar la búsqueda.</p>
                </div>
                <LumexDropdown  ShowArrow="true" >
                    <LumexDropdownTrigger>
                        <button type="button">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-700 hover:text-green-700 transition-all lucide lucide-list-filter-plus-icon lucide-list-filter-plus"><path d="M12 5H2"/><path d="M6 12h12"/><path d="M9 19h6"/><path d="M16 5h6"/><path d="M19 8V2"/></svg>
                        </button>
                    </LumexDropdownTrigger>
                    <LumexDropdownMenu>
                        <LumexDropdownItem OnClick="()=> SetFilterBy(BookFilterType.Name)" Id="by-name" class=@($" {(FilterBy == BookFilterType.Name ? "text-green-700" : "")}")>
                            <StartContent>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-album-icon lucide-album"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><polyline points="11 3 11 11 14 8 17 11 17 3"/></svg>
                            </StartContent>
                            <ChildContent>
                                <p class="text-[13px] font-normal">Filtrar por nombre</p>
                            </ChildContent> 
                        </LumexDropdownItem>
                        <LumexDropdownItem  OnClick="()=> SetFilterBy(BookFilterType.Author)" Id="by-author" class=@($" {(FilterBy == BookFilterType.Author ? "text-green-700" : "")}")>
                            <StartContent>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-tool-icon lucide-pen-tool"><path d="M15.707 21.293a1 1 0 0 1-1.414 0l-1.586-1.586a1 1 0 0 1 0-1.414l5.586-5.586a1 1 0 0 1 1.414 0l1.586 1.586a1 1 0 0 1 0 1.414z"/><path d="m18 13-1.375-6.874a1 1 0 0 0-.746-.776L3.235 2.028a1 1 0 0 0-1.207 1.207L5.35 15.879a1 1 0 0 0 .776.746L13 18"/><path d="m2.3 2.3 7.286 7.286"/><circle cx="11" cy="11" r="2"/></svg>
                                </StartContent>
                            <ChildContent>

                                <p class="text-[13px] font-normal">Filtrar por autor</p>
                            </ChildContent> 
                        </LumexDropdownItem>
                        <LumexDropdownItem  OnClick="()=> SetFilterBy(BookFilterType.Genre)" Id="by-genre" class=@($" {(FilterBy == BookFilterType.Genre ? "text-green-700" : "")}")>
                            <StartContent>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tag-icon lucide-tag"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                            </StartContent>
                            <ChildContent>
                                <p class="text-[13px] font-normal">Filtrar por genero</p>
                            </ChildContent> 
                        </LumexDropdownItem>
                    </LumexDropdownMenu>
                </LumexDropdown>
               
            </EditForm>
             <LumexChip Class="cursor-pointer p-2" Size="Size.Medium" @onclick='ShowCreateBookForm' Color="@ThemeColor.Primary" Variant="ChipVariant.Flat">
                    <EndContent>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-icon lucide-plus"><path d="M5 12h14"/><path d="M12 5v14"/></svg>                    
                    </EndContent>
                    <ChildContent>Crear libro</ChildContent>
                </LumexChip>
            <SectionDivider Name="Libros"/>
            <div class="grid max-sm:grid-cols-2 max-md:grid-cols-3 @@md:grid-cols-3 grid-cols-6 gap-8">
               
              
                @foreach (var book in Books)
                {
                    <BookCard OnBookDeleted="()=>{HandleOnBookDeleted(book);}" Book="@book" Index="Books.IndexOf(book)"/>
                }
                @if (_searchingBooks)
                {
                    <BookSkeleton Count="10"/>
                }

            </div>
            @if (_hasMore && !_searchingBooks)
            {
                <LumexButton OnClick="FetchGetMoreBooks" Variant="Variant.Light" Class="mt-4" Color="ThemeColor.Primary" >
                    Obtener Más
                </LumexButton>
            }
            else if(!Books.Any() && !_searchingBooks)
            {
                <div class="flex justify-center w-full items-center mt-4 flex-col" >
                    <p class="text-sm ">No hay más resultados</p>
                    <p class="text-xs ">Intenta buscar otra vez y ajusta los filtros para mejores resultados</p>

                </div>
                
            }

    
    
   
</div>





@functions{

    public void HandleOnBookDeleted(BookResponse book)
    {
        var bookToDelete = Books.FirstOrDefault(b => b.Id == book.Id);

        if(bookToDelete is null) return;

        Books.Remove(bookToDelete);
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync(){

        await FetchGetBooksOnSearchAsync();
    }
    protected override void OnInitialized()
    {
        RightBarContext.OnStateChanged += HandleStateChanged;
    }

    public async void HandleStateChanged(RightBarState state)
    {
        HandleBookCreated(state.CreatedBook);
        HandleBookUpdated(state.UpdatedBook);
        await InvokeAsync(StateHasChanged);
    }

    public async void HandleBookCreated(BookResponse? book)
    {
        if (book is not null)
        {
            Books.Insert(0, book);
          
        }
        await InvokeAsync(StateHasChanged);
    }
    
    public async Task HandleOnChange(bool contextIsValid, string? value)
    {
      
        if(!contextIsValid) return;
        Filter.Filter = value ?? "";
        
        if(cts is not null)
            await cts.CancelAsync();
        
        
        cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(500, cts.Token); // Espera 1 segundo
            await FetchGetBooksOnSearchAsync();
        }
        catch
        {
            
        }
       
    }
    public  void HandleBookUpdated(BookResponse? book)
    {
        if (book is not null)
        {
            var toReplace = Books.Find(b => b.Id == book.Id);
            
            if(toReplace is null) return;
            var index = Books.IndexOf(toReplace);
            
            if(index < 0) return;

            Books[index] = book;
            
          
        }
    }

    public void Dispose()
    {
        RightBarContext.OnStateChanged -= HandleStateChanged;

    }

 

    public async Task ShowCreateBookForm()
    {
        await RightBarContext.OpenCreateBookAsync();
    }
    
    public async Task SetFilterBy(BookFilterType filter){
        FilterBy = filter;
        await FetchGetBooksOnSearchAsync();
    }

    public async Task FetchGetMoreBooks()
    {
        if (!_hasMore) return;

        if(_searchCts is not null)
            await _searchCts.CancelAsync();
        
        _searchCts = new();

        _searchingBooks = true;
        StateHasChanged();
        var result = await BooksApiServices.GetByFilterAsync(BuildQuery(true), _searchCts.Token);
        
        if (result.IsSuccessful())
        {
            Books.AddRange(result.Data);
        }

        if (!result.IsSuccessful() || result.Data.Count() < 12)
        {
            _hasMore = false;
        }

        _searchingBooks = false;
        StateHasChanged();
    }

    public async Task FetchGetBooksOnSearchAsync()
    {
        if(_searchCts is not null)
            await _searchCts.CancelAsync();
        
        _searchCts = new();
        Books.Clear();
        _hasMore = true;
        _searchingBooks = true;
        StateHasChanged();
        var request = BuildQuery(false);
        var result = await BooksApiServices.GetByFilterAsync(request, _searchCts.Token);

        if (result.IsSuccessful())
        {
            Books = result.Data;
        }

        if (!result.IsSuccessful() || result.Data.Count() < 12)
        {
            _hasMore = false;
        }

        _searchingBooks = false;
        StateHasChanged();

    }

    public GetBooksByFilterRequest BuildQuery(bool withSkip = true) => new()
    {
        BookName = FilterBy == BookFilterType.Name ? Filter.Filter : null,
        GenreName = FilterBy == BookFilterType.Genre ? Filter.Filter : null,
        AuthorName = FilterBy == BookFilterType.Author ? Filter.Filter : null,
        Take = 12,
        Skip = withSkip  ? Books.Count : 0


    };
}

@code{

    public RenderFragment _filterContainer => @<p class="text-[13px] animate-pulse font-semibold text-violet-700 mt-[2px] text-nowrap">Por @filterTranslated</p>;
    public bool _hasMore { get; set; } = true;
    private CancellationTokenSource? cts;
    private CancellationTokenSource? _searchCts;
    public bool _searchingBooks { get; set; } = false;
    public FormFilter Filter { get; set; } = new();
    public string _prevFilter { get; set; } = "";
    public BookFilterType FilterBy {get; set;} = BookFilterType.Name;
    public GetBooksByFilterRequest GetBooksByFilterModel {get; set;} = new();
    public List<BookResponse> Books { get; set; } = new();

    public string filterPlaceholder => FilterBy switch
    {
        BookFilterType.Name => "Ej. Canción de hielo y fuego",
        BookFilterType.Author => "Ej. George R. R. Martin",
        BookFilterType.Genre => "Ej. Fantasía",
        _ => "Ej. Canción de hielo y fuego"
    };
    public string filterTranslated => FilterBy switch
    {
        BookFilterType.Name => "nombre",
        BookFilterType.Author => "autor",
        BookFilterType.Genre => "género",
        _ => "todo"
    };
    public enum BookFilterType
    {
        Author, 
        Name,
        Genre,
        All
    }

    public class FormFilter
    {
        [MaxLength(50, ErrorMessage ="El filtro debe de tener un maxio de 50 caracteres") ]
        public string Filter { get; set; } = "";
    }
}

