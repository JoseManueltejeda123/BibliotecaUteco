@page "/penalties"
@implements IDisposable
@using BibliotecaUteco.Client.Requests.Penalties.Queries
<PageTitle>Penalizaciones</PageTitle>
<div class="flex flex-col w-full mt-[20px] gap-4 px-4">

    <div class="flex w-full items-center gap-2 justify-between">
        <h2 class="text-3xl font-semibold">Penalizaciones</h2>
    </div>

    <div class="w-full flex flex-col gap-1">
        <LumexNumbox TValue="int"
                     minValue="0"
                     step="1"
                      Label="Buscar Penalización"
                      Behavior="InputBehavior.OnInput"
                      Clearable="true"
                      ValueChanged="async (e) => { await HandleOnChange(e); }"
                      OnCleared="FetchPenaltiesAsync"
                      Required="false"
                      Disabled="@(_searchingPenalties)"
                      Value="@Filter"
                      Placeholder="ID del prestamo"
                      LabelPlacement="@LabelPlacement.Outside"/>
        <p class="text-[13px]">Busca penalizaciones por el ID del prestamo o usa los filtros de abajo para filtrar por estado.</p>
    </div>
    
    <div class="mb-3 max-w-full flex items-center gap-2 flex-wrap">
        <LumexChip Class="cursor-pointer" 
                   Size="Size.Small" 
                   @onclick='async () => { await SetFilterBy(PenaltiesFilter.All); }' 
                   Variant="@(FilterBy == PenaltiesFilter.All ? ChipVariant.Solid : ChipVariant.Outlined)" 
                   Color="@ThemeColor.Primary">
            Todas
        </LumexChip>
        <LumexChip Class="cursor-pointer" 
                   Size="Size.Small" 
                   @onclick='async () => { await SetFilterBy(PenaltiesFilter.Pending); }' 
                   Variant="@(FilterBy == PenaltiesFilter.Pending ? ChipVariant.Solid : ChipVariant.Outlined)" 
                   Color="@ThemeColor.Primary">
            Sin Pagar
        </LumexChip>
        <LumexChip Class="cursor-pointer" 
                   Size="Size.Small" 
                   @onclick='async () => { await SetFilterBy(PenaltiesFilter.Paid); }' 
                   Variant="@(FilterBy == PenaltiesFilter.Paid ? ChipVariant.Solid : ChipVariant.Outlined)" 
                   Color="@ThemeColor.Primary">
            Pagadas
        </LumexChip>
    </div>

    <SectionDivider Name="Penalizaciones"/>
    <p class="text-[13px] font-semibold opacity-80 text-center">Las penalizaciones se crean automáticamente cuando se devuelve un préstamo vencido.</p>

    <div class="w-full flex flex-col gap-3">
        @if (Penalties.Any())
        {
            <div class="w-full grid max-sm:grid-cols-1 grid-cols-1 gap-3">
                @foreach (var penalty in Penalties)
                {
                    <PenaltyCard @key="penalty.Id" Penalty="@penalty"/>
                }
            </div>

            @if (_hasMore)
            {
                <LumexButton @onclick="FetchMorePenalties" 
                             Disabled="@(_searchingPenalties)" 
                             Variant="Variant.Light" 
                             Class="mt-4" 
                             Color="ThemeColor.Primary">
                    Obtener Más
                </LumexButton>
            }
        }
        else if (_searchingPenalties)
        {
            <div class="w-full justify-center items-center flex">
                <LumexSpinner Size="Size.Small" Variant="SpinnerVariant.Classic"/>
            </div>   
        }
        else if(Filter <= 0 && FilterBy == PenaltiesFilter.All)
        {
            <p class="text-[13px] text-center">No hay penalizaciones registradas</p>
        }
        else 
        {
            <NoResultsFound/>
        }
    </div>
</div>

@code {
    public PenaltiesFilter FilterBy { get; set; } = PenaltiesFilter.All;
    public int Filter { get; set; } = 0;
    public bool _searchingPenalties { get; set; } = false;
    public bool _hasMore { get; set; } = true;
    private CancellationTokenSource? cts;
    private CancellationTokenSource? fetchCts;
    public List<PenaltyResponse> Penalties { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        RightBarContext.OnStateChanged += HandlePayedPenaltyChanged;
        await FetchPenaltiesAsync();
    }
    
    public void Dispose()
    {
        RightBarContext.OnStateChanged -= HandlePayedPenaltyChanged;
    }

    public async Task HandleOnChange(int? value)
    {
        if (value < 0) return;
        
        Filter = value ?? 0;
        

        if (cts is not null)
            await cts.CancelAsync();

        cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(500, cts.Token); 
            await FetchPenaltiesAsync();
        }
        catch
        {
            // Cancelado, ignorar
        }
    }

    public async Task SetFilterBy(PenaltiesFilter filter)
    {
        FilterBy = filter;
        await FetchPenaltiesAsync();
    }

    public async void HandlePayedPenaltyChanged(RightBarState state)
    {
        if(state.PayedPenalty is null) return;
        
        var index = Penalties.FindIndex(p => p.Id == state.PayedPenalty.Id);
        
        if(index < 0) return;

        Penalties[index] = state.PayedPenalty;
        
        StateHasChanged();
    }

    public async Task FetchPenaltiesAsync()
    {
        try
        {
            if (fetchCts is not null)
            {
                await fetchCts.CancelAsync();
            }

            fetchCts = new();
            Penalties.Clear();
            _hasMore = true;
            _searchingPenalties = true;
            StateHasChanged();

            var request = BuildQuery();
            var result = await PenaltiesApiServices.GetByFilterAsync(request, fetchCts.Token);

            if (result.IsSuccessful())
            {
                Penalties = result.Data;
                _hasMore = result.Data.Count() >= 10;
            }
            else
            {
                _hasMore = false;
            }




            _searchingPenalties = false;
            StateHasChanged();
        }
        catch
        {
            _searchingPenalties = false;
            StateHasChanged();
        }
    }

    public async Task FetchMorePenalties()
    {
        try
        {
            if (!_hasMore) return;
            
            if (fetchCts is not null)
            {
                await fetchCts.CancelAsync();
            }

            fetchCts = new();
            _searchingPenalties = true;
            StateHasChanged();

           
           
            var result = await PenaltiesApiServices.GetByFilterAsync(BuildQuery(true), fetchCts.Token);

            if (result.IsSuccessful())
            {
                Penalties.AddRange(result.Data);
                _hasMore = result.Data.Count() >= 10;
            }
            
            
            _searchingPenalties = false;
            StateHasChanged();
        }
        catch
        {
            _searchingPenalties = false;
            StateHasChanged();
        }
    }

    public GetPenaltiesByFilterRequest BuildQuery(bool withSkip = false) => new()
    {
        LoanId = Filter,
        Take  = 10,
        IsDue = FilterBy switch
        {
            PenaltiesFilter.Pending => true,
            PenaltiesFilter.Paid => false,
            _ => null
        },
        Skip = withSkip ? Penalties.Count() : 0
    };

    public enum PenaltiesFilter
    {
        All,
        Pending,
        Paid
    }
}