@page "/transactions"
@implements IDisposable
@using BibliotecaUteco.Client.Requests.Transactions.Queries

<PageTitle>Transacciones</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="flex flex-col w-full mt-[20px] gap-4 px-4">

            <div class="flex w-full items-center gap-2 justify-between">
                <h2 class="text-3xl font-semibold">Transacciones de caja</h2>

            </div>

            <div class="flex w-full gap-2 items-center">
                <LumexTextbox 
                             
                             ValueChanged="async (e) => { await HandleOnInputChanged(e);}"
                              Label="Buscar transacciones"
                              Placeholder="Buscar por usuario"
                             Value="@Filter"    
                             Behavior="InputBehavior.OnInput"
                             LabelPlacement="@LabelPlacement.Outside"
                />
            
            </div>
            <div>
              @if(Summary is not null)
                {
                    <label class="text-sm font-normal">Estado de caja</label>
                    <p class="@($"text-[28px] font-semibold { (Summary.CashBoxState < 0 ? "text-red-600" : "text-green-600") }")">RD$ @(Summary.CashBoxState?.ToString("F2"))</p>

                    @if((Summary._lastRetirementDate - DateTime.Now).Days <= 15)
                    {
                        <p class="text-xs mt-2 font-semibold opacity-80">No se podrán hacer retiros hasta @Summary._lastRetirementDate.AddDays(15).ToString("dd MMMM yyyy hh:mm tt")</p>
                    }
                    
                }
            </div>

            <SectionDivider Name="Transacciones de caja"/>

           

            <div class="w-full flex flex-col gap-3">


                <button  @onclick="SetCreateRetirementViewAsync" class="hover:bg-green-50 cursor-pointer transition-all rounded-lg border-dashed border-2 w-full flex items-center justify-center p-2 border-green-600 gap-2">
                    <span class="text-green-600 font-semibold text-sm">Crear Transacción</span>
                </button>
                
                @if (Transactions.Any())
                {
                    @foreach (var transaction in Transactions)
                    {
                      
                        <TransactionCard Transaction="@transaction" @key="transaction.Id"/>

                       
                        var index = Transactions.IndexOf(transaction);

                        if (index < Transactions.Count - 1 && Transactions.Count > 1)
                        {
                            var nextTransaction = Transactions[index + 1];

                            if (nextTransaction.CreatedAt.Month != transaction.CreatedAt.Month ||
                            nextTransaction.CreatedAt.Year != transaction.CreatedAt.Year)
                            {
                              <SectionDivider Name="@nextTransaction.CreatedAt.ToString("MMMM yyyy")" />
                            }
                        }
                        

                    }
                    
                    
                }
                else if (!_hasMore && !string.IsNullOrEmpty(Filter) && !_fetchingTransactions)
                {
                    <NoResultsFound/>
                }
                
                else if(!_hasMore)
                {
                    <p class="text-center text-sm font-semibold opacity-80">No hay transacciones</p>
                }
              
                @if (_fetchingTransactions)
                {
                    <LumexSpinner Size="Size.Small" Variant="SpinnerVariant.Classic"/>

                }
                
                @if (!_fetchingTransactions && _hasMore)
                {
                    <LumexButton OnClick="FetchMore" Variant="Variant.Ghost" Color="ThemeColor.Primary">Obtener Mas</LumexButton>
                }


            </div>

        </div>
    </Authorized>
    <NotAuthorized>
        <div class="absolute w-full h-full flex flex-col gap-2 items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-off-icon lucide-circle-off"><path d="m2 2 20 20"/><path d="M8.35 2.69A10 10 0 0 1 21.3 15.65"/><path d="M19.08 19.08A10 10 0 1 1 4.92 4.92"/></svg>
            <p class="text-md font-semibold">No estas autorizado par acceder aquí</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code{
    
    public bool _fetchingTransactions {get; set;} = false;
    public string Filter { get; set; } = "";
    public List<TransactionResponse> Transactions { get; set; } = new();
    public CancellationTokenSource? _fetchCts {get; set;}
    public CancellationTokenSource? _inputCts {get; set;}
    public bool _hasMore {get; set;} = true;

    public CashBoxSummaryResponse? Summary {get; set;} = null;

    public bool _enableTransactions => Summary is not null && (Summary._lastRetirementDate - DateTime.Now).Days > 15;


}

@functions{


    public async Task FetchGetSummaryAsync()
    {
        var result = await TransactionsApiServices.GetSummaryAsync();

        if(result.IsSuccessful())
        {
            Summary = result.Data;
        };
    }
    public async Task SetCreateRetirementViewAsync()
    {
        await RightBarContext.OpenCreateRetirementAsync();
    }
    protected override async Task OnInitializedAsync()
    {
        await FetchGetTransactionsByFilterAsync();
        await FetchGetSummaryAsync();
        RightBarContext.OnStateChanged += HandleTransactionCreated;
        
    }

    public void Dispose()
    {
        RightBarContext.OnStateChanged -= HandleTransactionCreated;
    }

    public async void HandleTransactionCreated(RightBarState state)
    {
        if (state.CreatedTransaction is not null)
        {
            Transactions.Insert(0, state.CreatedTransaction);
            await InvokeAsync(StateHasChanged);
        }
    }
   
    public async Task HandleOnInputChanged(string? value)
    {
        
        Filter = value ?? "";

        if (_inputCts is not null)
        {
            await _inputCts.CancelAsync();
        }

        try
        {
            _inputCts = new();

            await Task.Delay(500, _inputCts.Token);
            
            await FetchGetTransactionsByFilterAsync();
        }
        catch
        {
        }
    }

    public async Task FetchGetTransactionsByFilterAsync()
    {
        if (_fetchingTransactions) return;

        if (_fetchCts is not null)
        {
            await _fetchCts.CancelAsync();
        }
        
        _fetchCts = new();
        _fetchingTransactions = true;
        Transactions.Clear();
        StateHasChanged();

        var result = await TransactionsApiServices.GetByFilterAsync(BuildQuery());

        if (result.IsSuccessful())
        {
            Transactions.AddRange(result.Data);
            _hasMore = result.Data.Count() >= 10;
        }
        else
        {
        _hasMore = false;
        }
        _fetchingTransactions = false;
        StateHasChanged();

    }
    
    public async Task FetchMore()
    {
        if (_fetchingTransactions) return;

        if (_fetchCts is not null)
        {
            await _fetchCts.CancelAsync();
        }
        
        _fetchCts = new();
        _fetchingTransactions = true;
        StateHasChanged();

        var result = await TransactionsApiServices.GetByFilterAsync(BuildQuery(true));

        if (result.IsSuccessful())
        {
            Transactions.AddRange(result.Data);
            _hasMore = result.Data.Count() >= 10;
        }
        else
        {
            _hasMore = false;
        }
        _fetchingTransactions = false;
        StateHasChanged();

    }

    public GetTransactionsByFilterRequest BuildQuery(bool withSkip = false) => new()
    {
        Skip = withSkip ? Transactions.Count() : 0,
        Take = 10,
        UserName = string.IsNullOrEmpty(Filter) ? null : Filter
        
    };


}